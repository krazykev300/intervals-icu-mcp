# Copy to .env on the host. chmod 600. Never commit .env.

INTERVALS_ICU_API_KEY=your_api_key_here
INTERVALS_ICU_ATHLETE_ID=i123456

# Destructive-tool gate (safe / full / none). Default: safe.
INTERVALS_ICU_DELETE_MODE=safe

# Tool catalog (coaching / full). This fork defaults to coaching.
INTERVALS_ICU_TOOL_PROFILE=coaching

# Align "today" for safe-mode event deletes with the athlete's timezone.
# TZ=America/Los_Angeles

# Optional: include `fetched_at` + `query_type` in every response's metadata
# block. Off by default to keep responses compact; enable for debugging.
# INTERVALS_ICU_DEBUG_METADATA=false

# HTTP bind is CLI flags, not env vars (stdio is the default for local uvx):
#   uv run intervals-icu-mcp --transport http --host 127.0.0.1 --port 8788
#
# Funnel (Claude.ai / iOS): generate a link token (`openssl rand -hex 32`) and
# send it as Authorization: Bearer. Never put the Intervals API key in Brain.
# See docs/identities.md and docs/claude-connector.md.
# INTERVALS_ICU_LINK_TOKEN=
# INTERVALS_ICU_HTTP_AUTH=auto
# INTERVALS_ICU_IDENTITIES_FILE=
